	quest.2C6F1BB8F5A64CBB.quest_desc: [
		"特殊机器:"
		"- 化学灌注机"
		"- 回旋式气液转换机"
		"- 太阳能中子活化器"
		"- 电解分离器"
		"- 同位素离心机"
		""
		"升级数 常规倍率 能耗倍率 特殊倍率 能耗倍率"
		"    1           1.33         1.78            2              2"
		"    2           1.78         3.16            4              4"
		"    3           2.37         5.62            8              8"
		"    4           3.16        10.00          16           16"
		"    5           4.22        17.78          32           32"
		"    6           5.62        31.62          64           64"
		"    7           7.50        56.23         128         128"
		"    8          10.00      100.00        256         256"
		"[ \"参考: \", { \"text\": \"MC百科\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://www.mcmod.cn/item/545952.html\" } } ]"
	]
	quest.320E578987E7BDA6.quest_desc: [
		"本整合包通过Controlify实现了部分的手柄支持"
		"以及通过KubeJS做了与TaCZ的适配"
		""
		"其中还有一个辅助瞄准功能(键鼠也能用),条件如下:"
		"1. 手持TaCZ枪械"
		"2. 副手手持末影之眼"
		"3. 处于瞄准状态"
		"4. 已经攻击过目标一次"
		"5. 目标未死亡"
	]
	quest.320E578987E7BDA6.quest_subtitle: "手柄玩Java版整合包?"
	quest.3295C75B84A5BB89.quest_desc: [
		"整合包内自带了几个枪包"
		"本整合包提供了枪械弹药自动化的方式"
		"你需要使用到沉浸工程中的蓝图"
	]
	quest.3295C75B84A5BB89.quest_subtitle: "这比魔法好用多了"
	quest.39CDEB7F8F305DB5.quest_desc: ["机器升级只提升并行"]
	quest.3B01973E36B3230B.quest_desc: [
		"能量: 1FE = 1RF = 0.5AE = 2.5J"
		"流体: 1B = 1000mB"
		"气体: 1B = 1000mB"
		"时间: 1s = 20tick"
		"注: MSPT(每刻毫秒数) <= 50 时TPS(刻每秒)能维持在20tick/s"
		""
		"k: 10^3(1,000)"
		"M: 10^6(1,000,000)"
		"G: 10^9(1,000,000,000)"
		"T: 10^12(1,000,000,000,000)"
		"P: 10^15(1,000,000,000,000,000)"
	]
